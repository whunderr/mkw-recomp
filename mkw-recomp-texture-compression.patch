diff --git a/i18n/ui/ca.po b/i18n/ui/ca.po
index e85295b..558238b 100644
--- a/i18n/ui/ca.po
+++ b/i18n/ui/ca.po
@@ -249,6 +249,19 @@ msgctxt "UI_MENU_TEX_QUALITY_QUARTER"
 msgid "Quarter"
 msgstr "Baixa"
 
+msgctxt "UI_MENU_TEX_COMPRESSION"
+msgid "Texture compression"
+msgstr ""
+
+msgctxt "UI_MENU_TEX_COMPRESSION_DESC"
+msgid ""
+"How the game's textures are kept in graphics memory on a card without ASTC (most PC cards). "
+"Automatic: BC1 for opaque textures and BC7 for those with transparency. BC1 + BC3 and BC1 + BC2 "
+"use BC3 or BC2 for the transparent ones instead: the same memory as BC7. BC7 skips BC1 and gives "
+"every texture BC7. Off keeps full-size textures: the most memory and the sharpest. Applies at the "
+"next start."
+msgstr ""
+
 msgctxt "UI_MENU_DETAIL"
 msgid "Detail distance"
 msgstr "Distància de detall"
